FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    PADDLE_PDX_MODEL_SOURCE=BOS

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip libglib2.0-0 libgl1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --timeout 300 --retries 8 \
    --index-url https://www.paddlepaddle.org.cn/packages/stable/cu118/ \
    paddlepaddle-gpu==3.0.0

RUN python3 -m pip install --no-cache-dir --timeout 300 --retries 8 \
    paddlex==3.1.0 paddleocr==3.1.0 fastapi==0.115.14 \
    "uvicorn[standard]==0.34.3" python-multipart==0.0.20 \
    langchain==0.3.30 langchain-community==0.3.31 \
    langchain-core==0.3.86 langchain-openai==0.3.35 \
    langchain-text-splitters==0.3.11 langsmith==0.10.4 \
    openai==2.45.0 numpy==2.1.2

WORKDIR /app
COPY app.py /app/app.py

EXPOSE 8080
CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
